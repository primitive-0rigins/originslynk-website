{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "originslynk-contact",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "20260801",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
