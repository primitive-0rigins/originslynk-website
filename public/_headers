# Cloudflare Pages response headers.
#
# The site is fully static. OriginsLynk behavior ships as same-origin external
# scripts; Cloudflare Pages injects its own performance beacon when Web Analytics
# is enabled for the project.

/*
  # 'unsafe-inline' is allowed for styles only because Astro scopes component
  # styles into inline <style> blocks. Executable inline script remains blocked.
  # The Cloudflare Insights origin is the only permitted third-party script host.
  #
  # The contact Worker is the only external form and fetch destination. Cloudflare's
  # automatically injected performance beacon reports through the same site origin.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://originslynk-contact.primitive-origins.workers.dev; form-action 'self' https://originslynk-contact.primitive-origins.workers.dev; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()

# HSTS is deliberately NOT set here.
#
# It belongs in Cloudflare's SSL/TLS -> Edge Certificates panel, where it is a
# reversible toggle, and it should be enabled only after the site has been live and
# correct for a week (CLOUDFLARE_CHECKLIST.md §1). Setting it in this file would ship
# a one-year policy on the very first deploy, before anyone has confirmed the domain
# works — and `includeSubDomains` would extend that to every client hostname.
#
# Browsers cache an HSTS policy for its full max-age and there is no way to reach out
# and clear it. That makes it the one setting in this tree that a mistake cannot be
# undone from.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=86400
