---
import type { Service } from '../data/services';

interface Props {
  service: Service;
  label?: string;
  featured?: boolean;
  details?: boolean;
}

const { service, label, featured = false, details = false }: Props = Astro.props;
const visibleIncludes = details ? service.includes : service.includes.slice(0, 3);
---

<article class:list={['service-card', { featured, managed: service.managed }]} id={service.id} data-service={service.id}>
  <div class={`service-visual visual-${service.id}`} aria-hidden="true">
    {service.id === 'personal-ai-agent-setup' && (
      <div class="workstation"><span class="screen"><i></i><i></i><i></i></span><span class="stand"></span></div>
    )}
    {service.id === 'role-automation-system' && (
      <div class="connections"><span></span><span></span><span></span><span></span></div>
    )}
    {service.id === 'managed-automation-appliance' && (
      <div class="mini-device"><span>OL</span><i></i></div>
    )}
  </div>

  <div class="service-body">
    {label && <p class="eyebrow">{label}</p>}
    <p class="service-price"><strong>{service.price}</strong><span>{service.priceNote}</span></p>
    <h3>{service.name}</h3>
    <p class="positioning">{service.positioning}</p>

    {details && (
      <>
        <p class="service-subhead">Best for</p>
        <p>{service.bestFor}</p>
        <p class="service-subhead">What OriginsLynk builds</p>
        <p>{service.builds}</p>
      </>
    )}

    <ul class="card-list">
      {visibleIncludes.map((item) => <li>{item}</li>)}
    </ul>

    <p class="responsibility">{service.shortLabel}</p>

    {details && (
      <>
        <div class="responsibility-details">
          <p class="service-subhead">What you operate</p>
          <ul class="card-list">
            {service.clientResponsibilities.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="responsibility-details">
          <p class="service-subhead">What OriginsLynk remains responsible for</p>
          <ul class="card-list">
            {service.originsLynkResponsibilities.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="exclusions">
          <p class="service-subhead">Does not include</p>
          <ul class="crosslist">
            {service.excludes.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </>
    )}

    <a
      href={`/contact?service=${service.id}`}
      class="service-link"
      data-analytics-event="pricing_card_click"
      data-analytics-service={service.id}
    >
      Ask about this service <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .service-card { display: flex; flex-direction: column; height: 100%; overflow: hidden; background: var(--ground-raised); border: var(--border-thin) solid var(--rule); border-radius: var(--radius-lg); transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition); }
  .service-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: var(--rule-strong); }
  .service-card.featured { border-color: #a9b9a2; box-shadow: var(--shadow-sm); }
  .service-card.managed { background: var(--ground-inverse); color: var(--ink-inverse); border-color: var(--ground-inverse); }
  .service-visual { min-height: 10rem; display: grid; place-items: center; background: linear-gradient(145deg, var(--ground-cream), var(--ground-sunken)); border-bottom: 1px solid var(--rule); overflow: hidden; }
  .managed .service-visual { background: linear-gradient(145deg, #303c37, #17201d); border-color: var(--rule-inverse); }
  .service-body { display: flex; flex-direction: column; flex: 1; padding: var(--space-6); }
  .service-body .eyebrow { font-size: .68rem; }
  .managed .eyebrow { color: #b7caaa; }
  .service-price { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--space-2); color: var(--ink); margin-bottom: var(--space-3); }
  .service-price strong { font-size: var(--text-2xl); line-height: 1; letter-spacing: var(--tracking-tight); }
  .service-price span { font-size: var(--text-xs); color: var(--ink-faint); }
  .managed .service-price, .managed h3, .managed .responsibility { color: var(--ink-inverse); }
  .managed .service-price span { color: var(--ink-inverse-muted); }
  h3 { font-size: var(--text-xl); margin-bottom: var(--space-3); }
  .positioning, .service-body > p:not(.service-price):not(.eyebrow):not(.responsibility):not(.service-subhead) { font-size: var(--text-sm); color: var(--ink-muted); }
  .managed .positioning, .managed .service-body > p { color: var(--ink-inverse-muted); }
  .service-subhead { margin-top: var(--space-5); color: var(--ink); font-size: var(--text-xs); font-weight: 720; letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  .managed .service-subhead { color: var(--ink-inverse); }
  .card-list { margin-top: var(--space-5); }
  .managed .card-list li { color: var(--ink-inverse-muted); }
  .managed .card-list li::before { border-color: #a9c29f; }
  .responsibility { margin-top: var(--space-6); padding-top: var(--space-4); border-top: var(--border-thin) solid var(--rule); color: var(--ink); font-weight: 720; font-size: var(--text-sm); }
  .managed .responsibility { border-color: var(--rule-inverse); }
  .responsibility-details { margin-top: var(--space-5); }
  .responsibility-details .service-subhead { margin-top: 0; }
  .responsibility-details .card-list { margin-top: var(--space-3); }
  .exclusions { margin-top: var(--space-5); padding: var(--space-4); background: var(--ground-sunken); border-radius: var(--radius); }
  .exclusions .service-subhead { margin-top: 0; }
  .managed .exclusions { background: rgba(255,255,255,.055); }
  .managed .crosslist li { color: var(--ink-inverse-muted); }
  .service-link { margin-top: auto; padding-top: var(--space-6); color: var(--accent-text); font-size: var(--text-sm); font-weight: 680; text-decoration: none; }
  .service-link span { margin-left: .2rem; transition: margin var(--transition); }
  .service-link:hover span { margin-left: .45rem; }
  .managed .service-link { color: #cfe0c8; }

  .workstation { width: 8rem; }
  .screen { height: 5rem; border: 4px solid #46534b; border-radius: 7px; background: #fff; padding: .9rem; display: grid; gap: .4rem; }
  .screen i { height: 5px; border-radius: 4px; background: #cbd6c5; }
  .screen i:nth-child(2) { width: 74%; background: #8da783; }
  .stand { display: block; width: 3.5rem; height: 1.5rem; border-bottom: 5px solid #46534b; margin: 0 auto; position: relative; }
  .stand::before { content: ""; position: absolute; width: 4px; height: 1.2rem; background: #46534b; left: 50%; }
  .connections { width: 8.5rem; height: 7rem; position: relative; }
  .connections::before, .connections::after { content: ""; position: absolute; background: var(--diagram-line); }
  .connections::before { width: 78%; height: 1px; left: 11%; top: 50%; }
  .connections::after { height: 78%; width: 1px; top: 11%; left: 50%; }
  .connections span { position: absolute; width: 2.1rem; height: 2.1rem; border: 1px solid #7f9279; border-radius: 50%; background: var(--ground-raised); z-index: 1; }
  .connections span:nth-child(1) { left: calc(50% - 1.05rem); top: calc(50% - 1.05rem); background: var(--accent); border-color: var(--accent); }
  .connections span:nth-child(2) { top: 0; left: calc(50% - 1.05rem); }
  .connections span:nth-child(3) { left: 0; top: calc(50% - 1.05rem); }
  .connections span:nth-child(4) { right: 0; top: calc(50% - 1.05rem); }
  .mini-device { width: 10rem; height: 5rem; border: 1px solid #52605a; border-radius: 9px 9px 14px 14px; background: linear-gradient(160deg, #36423d, #101613); box-shadow: 0 18px 24px rgba(0,0,0,.28); display: grid; place-items: center; position: relative; transform: perspective(280px) rotateX(4deg); }
  .mini-device span { color: #a8b8a2; border: 1px solid #778774; border-radius: 50%; width: 28px; height: 28px; display: grid; place-items: center; font-size: .55rem; font-weight: 720; }
  .mini-device i { position: absolute; right: 12px; bottom: 9px; width: 21px; height: 2px; background: #9bc08e; box-shadow: 0 0 8px #8eb681; }
</style>
