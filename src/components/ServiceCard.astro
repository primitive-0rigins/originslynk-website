---
import type { Service } from '../data/services';

interface Props {
  service: Service;
  label?: string;
  featured?: boolean;
  details?: boolean;
}

const { service, label, featured = false, details = false }: Props = Astro.props;
const visibleIncludes = details ? service.includes : service.includes.slice(0, 4);
---

<article class:list={['service-card', { featured, managed: service.managed, diagnostic: service.diagnostic }]} id={service.id} data-service={service.id}>
  <div class="service-topline">
    {label && <p class="eyebrow">{label}</p>}
    {featured && <span class="fit-badge">Best place to start</span>}
  </div>

  <p class="service-price"><strong>{service.price}</strong><span>{service.priceNote}</span></p>
  <h3>{service.name}</h3>
  <p class="positioning">{service.positioning}</p>

  {details && (
    <>
      <p class="service-subhead">Right for you when</p>
      <p>{service.bestFor}</p>
      <p class="service-subhead">What you receive</p>
      <p>{service.builds}</p>
    </>
  )}

  <ul class="card-list">
    {visibleIncludes.map((item) => <li>{item}</li>)}
  </ul>

  <p class="responsibility">{service.shortLabel}</p>

  {details && (
    <>
      <div class="responsibility-details">
        <p class="service-subhead">Your part</p>
        <ul class="card-list">
          {service.clientResponsibilities.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="responsibility-details">
        <p class="service-subhead">Our part</p>
        <ul class="card-list">
          {service.originsLynkResponsibilities.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="exclusions">
        <p class="service-subhead">Not included</p>
        <ul class="crosslist">
          {service.excludes.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </>
  )}

  <a
    href={`/contact?service=${service.id}`}
    class="service-link"
    data-analytics-event="pricing_card_click"
    data-analytics-service={service.id}
  >
    Request this service <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .service-card { display: flex; flex-direction: column; height: 100%; padding: clamp(1.35rem, 3vw, var(--space-6)); background: var(--ground-raised); border: var(--border-thin) solid var(--rule); border-radius: var(--radius-lg); transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition); }
  .service-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: var(--rule-strong); }
  .service-card.featured { border: 2px solid var(--secondary); box-shadow: var(--shadow-sm); }
  .service-card.managed { background: var(--ground-inverse); color: var(--ink-inverse); border-color: var(--ground-inverse); }
  .service-card.diagnostic { background: linear-gradient(145deg, #fffefa, #f4efe4); }
  .service-topline { min-height: 2rem; display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-3); }
  .service-topline .eyebrow { margin: 0; font-size: .68rem; }
  .managed .eyebrow { color: #9fd2cb; }
  .fit-badge { flex-shrink: 0; padding: .28rem .5rem; border-radius: 999px; background: var(--secondary-soft); color: var(--secondary-dark); font-size: .66rem; font-weight: 760; }
  .service-price { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-5); color: var(--ink); }
  .service-price strong { font-size: var(--text-2xl); line-height: 1; letter-spacing: var(--tracking-tight); }
  .service-price span { max-width: 24ch; font-size: var(--text-xs); color: var(--ink-faint); }
  .managed .service-price, .managed h3, .managed .responsibility { color: var(--ink-inverse); }
  .managed .service-price span { color: var(--ink-inverse-muted); }
  h3 { margin-top: var(--space-4); font-size: var(--text-xl); }
  .positioning, .service-card > p:not(.service-price):not(.responsibility):not(.service-subhead) { margin-top: var(--space-3); font-size: var(--text-sm); color: var(--ink-muted); }
  .managed .positioning, .managed > p { color: var(--ink-inverse-muted); }
  .service-subhead { margin-top: var(--space-5); color: var(--ink); font-size: var(--text-xs); font-weight: 760; letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  .managed .service-subhead { color: var(--ink-inverse); }
  .card-list { margin-top: var(--space-5); }
  .managed .card-list li { color: var(--ink-inverse-muted); }
  .managed .card-list li::before { border-color: #8fd0c6; }
  .responsibility { margin-top: var(--space-6); padding-top: var(--space-4); border-top: var(--border-thin) solid var(--rule); color: var(--ink); font-weight: 760; font-size: var(--text-sm); }
  .managed .responsibility { border-color: var(--rule-inverse); }
  .responsibility-details { margin-top: var(--space-5); }
  .responsibility-details .service-subhead { margin-top: 0; }
  .responsibility-details .card-list { margin-top: var(--space-3); }
  .exclusions { margin-top: var(--space-5); padding: var(--space-4); background: var(--ground-sunken); border-radius: var(--radius); }
  .exclusions .service-subhead { margin-top: 0; }
  .managed .exclusions { background: rgba(255,255,255,.06); }
  .managed .crosslist li { color: var(--ink-inverse-muted); }
  .service-link { margin-top: auto; padding-top: var(--space-6); color: var(--accent-text); font-size: var(--text-sm); font-weight: 760; text-decoration: none; }
  .service-link span { margin-left: .2rem; transition: margin var(--transition); }
  .service-link:hover span { margin-left: .45rem; }
  .managed .service-link { color: #f3b6a5; }
</style>
