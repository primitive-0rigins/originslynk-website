---
// A restrained schematic of the envelope every workflow runs inside:
// existing tools are read, a workflow interprets and prepares, output waits as a
// draft, and a person approves. The approval gate is the only element drawn in the
// accent color — it is the point of the picture.
//
// Decorative: the surrounding page states the same thing in text, so this is
// aria-hidden by the caller rather than described.
---

<svg viewBox="0 0 420 300" role="presentation" class="schematic">
  <!-- existing tools -->
  <g class="node-group">
    <rect x="8" y="24" width="118" height="34" rx="6" />
    <text x="24" y="45">Email</text>

    <rect x="8" y="70" width="118" height="34" rx="6" />
    <text x="24" y="91">Calendar</text>

    <rect x="8" y="116" width="118" height="34" rx="6" />
    <text x="24" y="137">Documents</text>

    <rect x="8" y="162" width="118" height="34" rx="6" />
    <text x="24" y="183">Forms &amp; tools</text>
  </g>
  <text x="8" y="16" class="label">YOUR EXISTING TOOLS</text>

  <!-- read paths -->
  <g class="line">
    <path d="M126 41 C 156 41, 156 104, 182 104" />
    <path d="M126 87 C 156 87, 156 104, 182 104" />
    <path d="M126 133 C 156 133, 156 110, 182 110" />
    <path d="M126 179 C 156 179, 156 112, 182 112" />
  </g>
  <text x="140" y="205" class="label-sm">read</text>

  <!-- the workflow -->
  <rect x="182" y="72" width="112" height="72" rx="8" class="node-strong" />
  <text x="238" y="100" class="node-title" text-anchor="middle">Workflow</text>
  <text x="238" y="118" class="node-sub" text-anchor="middle">interpret</text>
  <text x="238" y="132" class="node-sub" text-anchor="middle">prepare</text>

  <!-- to draft -->
  <path d="M294 108 L 330 108" class="line" />
  <path d="M324 103 L 331 108 L 324 113" class="line arrow" />

  <!-- draft, waiting -->
  <rect x="330" y="86" width="82" height="44" rx="6" class="node-group-rect" />
  <text x="371" y="106" class="node-title" text-anchor="middle">Draft</text>
  <text x="371" y="121" class="node-sub" text-anchor="middle">not sent</text>

  <!-- the approval gate: the one accent element -->
  <g class="gate">
    <path d="M371 130 L 371 180" />
    <circle cx="371" cy="196" r="16" />
    <path d="M364 196 l5 5 l9 -10" class="tick" />
  </g>
  <text x="371" y="232" class="gate-label" text-anchor="middle">You approve</text>

  <!-- and only then does anything leave -->
  <path d="M371 212 L 371 248" class="line dashed" />
  <path d="M366 242 L 371 249 L 376 242" class="line arrow" />
  <text x="371" y="272" class="label-sm" text-anchor="middle">sent · published · filed</text>

  <!-- boundary -->
  <rect x="170" y="56" width="160" height="104" rx="10" class="boundary" />
  <text x="250" y="50" class="label" text-anchor="middle">ORIGINSLYNK</text>
</svg>

<style>
  .schematic {
    width: 100%;
    height: auto;
    max-width: 460px;
    margin-inline: auto;
    font-family: var(--font-sans);
  }

  .node-group rect,
  .node-group-rect {
    fill: var(--ground-raised);
    stroke: var(--rule-strong);
    stroke-width: 1;
  }

  .node-strong {
    fill: var(--ground-raised);
    stroke: var(--diagram-accent);
    stroke-width: 1.5;
  }

  .boundary {
    fill: none;
    stroke: var(--diagram-line);
    stroke-width: 1;
    stroke-dasharray: 3 4;
    opacity: 0.7;
  }

  text {
    fill: var(--ink-muted);
    font-size: 11px;
  }

  .node-title {
    fill: var(--ink);
    font-size: 12px;
    font-weight: 600;
  }

  .node-sub {
    fill: var(--ink-faint);
    font-size: 10px;
  }

  .label {
    fill: var(--ink-faint);
    font-size: 8.5px;
    letter-spacing: 0.09em;
    font-weight: 650;
  }

  .label-sm {
    fill: var(--ink-faint);
    font-size: 9px;
    letter-spacing: 0.04em;
  }

  .line,
  .line path {
    fill: none;
    stroke: var(--diagram-line);
    stroke-width: 1.2;
    stroke-linecap: round;
  }

  .arrow { fill: none; stroke-linejoin: round; }

  .dashed { stroke-dasharray: 4 4; }

  .gate path,
  .gate circle {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .gate circle { fill: var(--accent-soft); }

  .tick { stroke-width: 2; stroke-linejoin: round; }

  .gate-label {
    fill: var(--accent-text);
    font-size: 11px;
    font-weight: 650;
  }
</style>
