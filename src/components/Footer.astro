---
const email = import.meta.env.PUBLIC_CONTACT_EMAIL || 'bryce@originslynk.com';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <p class="footer-name">OriginsLynk</p>
      <p class="small muted">Role-specific automation systems by Primitive Origins LLC.</p>
      <p class="small muted">Anderson, South Carolina.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <div>
        <h2 class="footer-heading">Service</h2>
        <ul>
          <li><a href="/services">What we build</a></li>
          <li><a href="/pricing">Pricing</a></li>
          <li><a href="/trust">Trust &amp; safety</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer-heading">Get in touch</h2>
        <ul>
          <li><a href="/contact">Book a consultation</a></li>
          <li><a href={`mailto:${email}`}>{email}</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="container footer-legal">
    <p class="small muted">
      &copy; {year} Primitive Origins LLC. Independent setup and support — not affiliated
      with, endorsed by, or a reseller of any AI, email, or business-software provider.
      Services are configured against accounts and subscriptions the client owns.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: var(--border-thin) solid var(--rule);
    background: var(--ground-sunken);
    padding-top: var(--space-7);
  }

  .footer-inner {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 44em) {
    .footer-inner { grid-template-columns: 1.2fr 1fr; }
  }

  .footer-name {
    font-family: var(--heading-font);
    font-weight: 650;
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .footer-brand p + p { margin-top: var(--space-1); }

  .footer-nav {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
  }

  .footer-heading {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--space-3);
  }

  .footer-nav ul { list-style: none; padding: 0; margin: 0; }
  .footer-nav li + li { margin-top: var(--space-2); }
  .footer-nav a {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    text-decoration: none;
  }
  .footer-nav a:hover { color: var(--ink); text-decoration: underline; }

  .footer-legal {
    margin-top: var(--space-7);
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
    border-top: var(--border-thin) solid var(--rule);
  }

  .footer-legal p { max-width: 70ch; }
</style>
