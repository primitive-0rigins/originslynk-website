---
const email = import.meta.env.PUBLIC_CONTACT_EMAIL || 'bryce@originslynk.com';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-wordmark">Origins<span>Lynk</span></a>
      <p>Practical systems for less repetitive work and more time away from it.</p>
      <p class="footer-place">A Primitive Origins company · Anderson, South Carolina</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <div>
        <h2>Explore</h2>
        <ul>
          <li><a href="/services">Services</a></li>
          <li><a href="/pricing">Pricing</a></li>
          <li><a href="/#process">How it works</a></li>
        </ul>
      </div>
      <div>
        <h2>Company</h2>
        <ul>
          <li><a href="/trust">Trust &amp; safety</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h2>Start here</h2>
        <ul>
          <li><a href="/contact">Request a workflow review</a></li>
          <li><a href={`mailto:${email}`}>{email}</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="container footer-legal">
    <p>
      &copy; {year} Primitive Origins LLC. Independent setup and support—not affiliated
      with, endorsed by, or a reseller of any AI, email, or business-software provider.
      Services use accounts and subscriptions the client owns.
    </p>
  </div>
</footer>

<style>
  .site-footer { margin-top: auto; background: var(--ground-inverse); color: var(--ink-inverse); padding-top: var(--space-8); }
  .footer-inner { display: grid; gap: var(--space-8); }
  .footer-wordmark { color: var(--ink-inverse); text-decoration: none; font-weight: 720; font-size: var(--text-xl); }
  .footer-wordmark:hover { color: var(--ink-inverse); }
  .footer-wordmark span { color: #a9c29f; }
  .footer-brand > p { color: var(--ink-inverse-muted); font-size: var(--text-sm); margin-top: var(--space-4); max-width: 38ch; }
  .footer-brand .footer-place { margin-top: var(--space-2); color: #9fa8a2; }
  .footer-nav { display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); }
  .footer-nav h2 { font-family: var(--font-sans); font-size: var(--text-xs); font-weight: 720; letter-spacing: var(--tracking-wide); text-transform: uppercase; color: #aeb6b0; margin-bottom: var(--space-4); }
  .footer-nav ul { list-style: none; padding: 0; }
  .footer-nav li + li { margin-top: var(--space-2); }
  .footer-nav a { font-size: var(--text-sm); color: var(--ink-inverse-muted); text-decoration: none; }
  .footer-nav a:hover { color: #fff; }
  .footer-legal { margin-top: var(--space-8); padding-block: var(--space-5); border-top: var(--border-thin) solid var(--rule-inverse); }
  .footer-legal p { color: #99a29c; font-size: var(--text-xs); max-width: 86ch; }
  @media (min-width: 54em) {
    .footer-inner { grid-template-columns: 1fr 1.3fr; }
  }
</style>
