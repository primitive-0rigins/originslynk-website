---
import Base from '../layouts/Base.astro';

const defaultEndpoint = 'https://originslynk-contact.primitive-origins.workers.dev';
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || defaultEndpoint;
const email = import.meta.env.PUBLIC_CONTACT_EMAIL || 'bryce@originslynk.com';
const configured = endpoint.length > 0;
---

<Base title="Request a service" description="Tell OriginsLynk what repeats, breaks, or gets missed in your business. A short intake helps identify the right first service.">
  <section class="section-cream contact-section">
    <div class="container form-layout">
      <div class="form-intro">
        <p class="eyebrow">A short, useful intake</p>
        <h1>What keeps stealing time—or slipping through?</h1>
        <p class="lede">You do not need a technical diagnosis. Describe the work in plain language and we will get to the core of the problem.</p>

        <div class="expectation-card">
          <p><strong>What happens next</strong></p>
          <ol>
            <li>Bryce reviews your request personally.</li>
            <li>You receive a reply within one business day.</li>
            <li>A free 15-minute fit call confirms the most useful next step.</li>
          </ol>
        </div>

        <div class="form-boundary">
          <p><strong>Please keep sensitive details out of this form.</strong></p>
          <p>Do not send passwords, access codes, financial records, health information, or private client records. Secure access is handled separately after approval.</p>
          <a href="/trust#data-handling">See how access is handled →</a>
        </div>
      </div>

      <div class="form-panel">
        <form action={configured ? endpoint : '/contact'} method="POST" class="form" data-consultation-form data-form-mode={configured ? 'endpoint' : 'email'} data-contact-email={email}>
          <div class="form-heading">
            <p class="eyebrow">About 3 minutes</p>
            <h2>Request a service</h2>
            <p class="form-note small">Required fields are marked with an asterisk.</p>
          </div>

          <fieldset>
            <legend><span>01</span> Who should we reply to?</legend>
            <div class="field-grid">
              <div class="field">
                <label for="name">Your name <span class="req" aria-hidden="true">*</span></label>
                <input type="text" id="name" name="name" required autocomplete="name" maxlength="100" />
              </div>
              <div class="field">
                <label for="email">Work email <span class="req" aria-hidden="true">*</span></label>
                <input type="email" id="email" name="email" required autocomplete="email" maxlength="160" />
              </div>
            </div>
            <div class="field">
              <label for="organization">Business name <span class="req" aria-hidden="true">*</span></label>
              <input type="text" id="organization" name="organization" required autocomplete="organization" maxlength="140" />
            </div>
          </fieldset>

          <fieldset>
            <legend><span>02</span> What needs to change?</legend>
            <div class="field">
              <label for="challenge">Which situation is closest? <span class="req" aria-hidden="true">*</span></label>
              <select id="challenge" name="challenge" required>
                <option value="">Choose one</option>
                <option value="Repetitive admin work">The same admin work repeats every week</option>
                <option value="Follow-up or handoffs get missed">Follow-up or handoffs get missed</option>
                <option value="Existing automation is unreliable">An existing automation is unreliable</option>
                <option value="Reporting or document preparation takes too long">Reporting or document preparation takes too long</option>
                <option value="Unclear where to start">I know time is being wasted but not where to start</option>
                <option value="Other business process problem">Something else</option>
              </select>
            </div>

            <div class="field">
              <label for="problem">Walk me through what happens now. <span class="req" aria-hidden="true">*</span></label>
              <p class="hint" id="problem-hint">What starts the work, what do you do by hand, and where does it slow down or fail?</p>
              <textarea id="problem" name="problem" rows="5" required maxlength="1200" aria-describedby="problem-hint"></textarea>
            </div>

            <div class="field">
              <label for="desired_outcome">What should happen instead? <span class="req" aria-hidden="true">*</span></label>
              <p class="hint" id="outcome-hint">Describe the result you want—not the technology you think you need.</p>
              <textarea id="desired_outcome" name="desired_outcome" rows="3" required maxlength="700" aria-describedby="outcome-hint"></textarea>
            </div>

            <div class="field-grid">
              <div class="field">
                <label for="sensitivity">Sensitive or regulated information? <span class="req" aria-hidden="true">*</span></label>
                <select id="sensitivity" name="sensitivity" required>
                  <option value="">Choose one</option>
                  <option value="No sensitive or regulated information known">No</option>
                  <option value="Sensitive or regulated information may be involved">Yes or maybe</option>
                  <option value="Not sure">Not sure</option>
                </select>
              </div>
              <div class="field">
                <label for="service">Service <span class="optional">(optional)</span></label>
                <select id="service" name="service">
                  <option value="">Recommend the right one</option>
                  <option value="automation-health-check">Automation Health Check · from $350</option>
                  <option value="tier-1-intelligence-setup">Tier 1 Intelligence Setup · $750</option>
                  <option value="tier-2-intelligence-setup">Tier 2 Intelligence Setup · $1,200</option>
                  <option value="tier-3-intelligence-setup">Tier 3 Intelligence Setup · from $2,800 + $250/month</option>
                </select>
              </div>
            </div>
          </fieldset>

          <div class="consent-field">
            <input type="checkbox" id="consent" name="consent" value="yes" required />
            <label for="consent">I consent to OriginsLynk contacting me about this request and using this information as described in the <a href="/privacy">Privacy Policy</a>. <span class="req" aria-hidden="true">*</span></label>
          </div>

          <div class="trap" aria-hidden="true">
            <label for="company-website">Leave this field empty</label>
            <input type="text" id="company-website" name="company_website" tabindex="-1" autocomplete="off" />
          </div>

          <button type="submit" class="btn btn-primary form-submit">{configured ? 'Send my request' : 'Prepare my request'}</button>
          <p class="submit-note">No pressure. No credentials. No surprise work.</p>
          <p id="form-status" class="form-status small" role="status" aria-live="polite" hidden></p>
          <a id="prepared-email" class="btn btn-secondary prepared-email" href={`mailto:${email}`} hidden>Open prepared email</a>
          <p class="direct-email small muted">Prefer email? Write to <a href={`mailto:${email}?subject=Service%20request`}>{email}</a>.</p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script is:inline src="/scripts/contact.js" defer></script>

<style>
  .contact-section { padding-block: clamp(3.25rem, 6vw, var(--space-8)); }
  .form-layout { display: grid; gap: var(--space-7); align-items: start; }
  .form-intro h1 { max-width: 13ch; }
  .form-intro > .lede { margin-top: var(--space-5); max-width: 48ch; }
  .expectation-card, .form-boundary { margin-top: var(--space-6); padding: var(--space-5); border-radius: var(--radius); }
  .expectation-card { background: var(--secondary-soft); border-left: var(--border-thick) solid var(--secondary); }
  .expectation-card ol { margin-top: var(--space-3); padding-left: var(--space-5); color: var(--ink-muted); font-size: var(--text-sm); }
  .expectation-card li + li { margin-top: var(--space-2); }
  .form-boundary { background: var(--ground-sunken); }
  .form-boundary p { color: var(--ink-muted); font-size: var(--text-sm); }
  .form-boundary p + p { margin-top: var(--space-2); }
  .form-boundary strong { color: var(--ink); }
  .form-boundary a { display: inline-block; margin-top: var(--space-3); font-size: var(--text-xs); font-weight: 760; text-decoration: none; }
  .form-panel { background: var(--ground-raised); border: 1px solid var(--rule); border-radius: var(--radius-lg); padding: clamp(1.25rem, 4vw, var(--space-7)); box-shadow: var(--shadow-lg); }
  .form-heading { padding-bottom: var(--space-5); border-bottom: 1px solid var(--rule); }
  .form-heading h2 { font-size: var(--text-2xl); }
  .form-note { margin-top: var(--space-3); color: var(--ink-faint); }
  fieldset { padding: 0; border: 0; margin-top: var(--space-7); }
  legend { width: 100%; margin-bottom: var(--space-5); color: var(--ink); font-size: var(--text-sm); font-weight: 760; letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  legend span { color: var(--accent-text); margin-right: var(--space-2); }
  .field-grid { display: grid; gap: var(--space-5); }
  .field + .field, .field-grid + .field, .field + .field-grid { margin-top: var(--space-5); }
  label { display: block; margin-bottom: var(--space-2); font-size: var(--text-sm); font-weight: 680; }
  .req { color: var(--accent-text); }
  .optional { color: var(--ink-faint); font-weight: 400; }
  .hint { margin: calc(var(--space-1) * -1) 0 var(--space-2); color: var(--ink-faint); font-size: var(--text-xs); }
  input, textarea, select { width: 100%; min-height: 48px; padding: var(--space-3); background: var(--ground); border: 1px solid var(--rule-strong); border-radius: var(--radius); font-size: var(--text-base); transition: border-color var(--transition), box-shadow var(--transition); }
  textarea { resize: vertical; line-height: var(--leading-snug); }
  input:focus, textarea:focus, select:focus { outline: none; border-color: var(--secondary); box-shadow: 0 0 0 var(--focus-width) rgba(32,122,114,.22); }
  input:user-invalid, textarea:user-invalid, select:user-invalid { border-color: var(--danger); }
  .consent-field { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start; margin-top: var(--space-7); }
  .consent-field input { width: 1.1rem; min-height: 1.1rem; margin-top: .2rem; }
  .consent-field label { margin: 0; color: var(--ink-muted); }
  .form-submit, .prepared-email { width: 100%; margin-top: var(--space-5); }
  .form-submit:disabled { opacity: .65; cursor: wait; }
  .submit-note { max-width: none; margin-top: var(--space-2); color: var(--ink-faint); font-size: var(--text-xs); text-align: center; }
  .form-status { margin-top: var(--space-4); padding: var(--space-3); border-radius: var(--radius); color: var(--ink-muted); background: var(--ground-sunken); }
  .form-status.is-success { border-left: var(--border-thick) solid var(--ok); color: var(--ink); }
  .form-status.is-error { border-left: var(--border-thick) solid var(--danger); }
  .direct-email { margin-top: var(--space-4); }
  .trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (min-width: 42em) { .field-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64em) {
    .form-layout { grid-template-columns: .8fr 1.2fr; gap: var(--space-8); }
    .form-intro { position: sticky; top: calc(var(--space-8) + var(--space-5)); }
  }
</style>
