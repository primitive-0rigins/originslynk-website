---
import Base from '../layouts/Base.astro';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || '';
const email = import.meta.env.PUBLIC_CONTACT_EMAIL || 'bryce@originslynk.com';

// No endpoint configured yet? Show the fallback rather than a form that posts
// nowhere. A form that silently swallows a prospect's message is worse than no
// form. See the ops repo DECISIONS.md D-04.
const configured = endpoint.length > 0;
---

<Base
  title="Request a workflow review"
  description="Tell OriginsLynk which repetitive task consumes the most time, which tools are involved, and what result would make the work worthwhile."
>
  <section class="section-cream contact-section">
    <div class="container form-layout">
      <div class="form-intro">
        <p class="eyebrow">Workflow review</p>
        <h1>Find the repetitive work worth removing.</h1>
        <p class="lede" style="margin-top: var(--space-5)">
          Tell us what role you perform, which task consumes the most time, and which tools
          you already use. We will identify a practical first workflow, recommend the right
          service level, and explain what should remain human-approved.
        </p>

        <h2 class="intro-h">What happens next</h2>
        <ol class="next-steps">
          <li>We review the request and reply within one business day.</li>
          <li>A discovery conversation maps the current process and its first useful workflow.</li>
          <li>You receive a written scope, price, responsibilities, and support period before purchasing.</li>
        </ol>

        <p class="small muted" style="margin-top: var(--space-6)">
          If the honest conclusion is that nothing here is worth automating yet, we will
          tell you. That answer costs us a sale and saves you a system you did not need.
        </p>

        <p class="small muted" style="margin-top: var(--space-4)">
          What you send here goes to us and is used to prepare for that conversation.
          It is not added to a mailing list, sold, or fed to an analytics tool.
        </p>

        <p class="safety-note small">
          Do not submit passwords, access codes, private keys, medical information,
          financial account numbers, or other sensitive records. Account access is handled
          separately after a project is approved.
        </p>
      </div>

      <div class="form-panel">
        {configured ? (
          <form action={endpoint} method="POST" class="form" data-consultation-form>
            <p class="form-note small">All fields marked <span aria-hidden="true">*</span> are required.</p>

            <div class="field">
              <label for="name">Name <span class="req" aria-hidden="true">*</span></label>
              <input type="text" id="name" name="name" required autocomplete="name" />
            </div>

            <div class="field">
              <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
              <input type="email" id="email" name="email" required autocomplete="email" />
            </div>

            <div class="field">
              <label for="organization">Business or organization <span class="optional">(optional)</span></label>
              <input type="text" id="organization" name="organization" autocomplete="organization" />
            </div>

            <div class="field">
              <label for="role">Your role <span class="req" aria-hidden="true">*</span></label>
              <input
                type="text"
                id="role"
                name="role"
                required
                autocomplete="organization-title"
                placeholder="e.g. marketing director, office manager, agent"
              />
            </div>

            <div class="field">
              <label for="service">Service you are considering</label>
              <select id="service" name="service">
                <option value="">Not sure yet</option>
                <option value="personal-ai-assistant-starter">$750 Personal AI Assistant Setup</option>
                <option value="assistant-role-system">$1,200 AI Workflow System</option>
                <option value="managed-automation">From $2,800 Managed Automation Appliance</option>
              </select>
            </div>

            <div class="field">
              <label for="users">How many people would use the system?</label>
              <select id="users" name="users">
                <option value="">Not sure</option>
                <option value="1">One person</option>
                <option value="2-5">2–5 people</option>
                <option value="6+">6 or more people</option>
              </select>
            </div>

            <div class="field">
              <label for="problem">
                What repeats most? <span class="req" aria-hidden="true">*</span>
              </label>
              <p class="hint" id="problem-hint">
                The task you would hand off first. Plain description is fine.
              </p>
              <textarea
                id="problem"
                name="problem"
                rows="5"
                required
                aria-describedby="problem-hint"
              ></textarea>
            </div>

            <div class="field">
              <label for="tools">Tools you use today</label>
              <p class="hint" id="tools-hint">Email, CRM, spreadsheets, whatever it actually is.</p>
              <input type="text" id="tools" name="tools" aria-describedby="tools-hint" />
            </div>

            <div class="field">
              <label for="frequency">How often does the task happen?</label>
              <input type="text" id="frequency" name="frequency" placeholder="e.g. every weekday, weekly, 20 times a month" />
            </div>

            <div class="field">
              <label for="hours">Rough hours a week it costs you</label>
              <input
                type="number"
                id="hours"
                name="hours"
                min="0"
                max="60"
                step="0.5"
                inputmode="decimal"
              />
            </div>

            <div class="field">
              <label for="phone">Phone <span class="optional">(optional)</span></label>
              <input type="tel" id="phone" name="phone" autocomplete="tel" />
            </div>

            <div class="field">
              <label for="sensitivity">Does it involve customers or sensitive information?</label>
              <select id="sensitivity" name="sensitivity">
                <option value="">Not sure</option>
                <option value="no">No</option>
                <option value="customer-communication">Customer communication</option>
                <option value="sensitive-information">Sensitive information</option>
                <option value="both">Both</option>
              </select>
            </div>

            <div class="field">
              <label for="outcome">What result would make this worthwhile?</label>
              <textarea id="outcome" name="outcome" rows="3"></textarea>
            </div>

            <div class="consent-field">
              <input type="checkbox" id="consent" name="consent" value="yes" required />
              <label for="consent">OriginsLynk may use this information to respond to my request. <span class="req" aria-hidden="true">*</span></label>
            </div>

            <!-- Spam trap. Bots fill hidden fields; people never see this one.
                 Hidden from assistive technology as well as visually, so it is not
                 announced to screen-reader users as an unlabeled input. -->
            <div class="trap" aria-hidden="true">
              <label for="company-website">Leave this field empty</label>
              <input type="text" id="company-website" name="company_website" tabindex="-1" autocomplete="off" />
            </div>

            <button type="submit" class="btn btn-primary form-submit">Request a workflow review</button>

            <p id="form-status" class="form-status small" role="status" aria-live="polite" hidden></p>

            <p class="small muted" style="margin-top: var(--space-4)">
              Or email <a href={`mailto:${email}`}>{email}</a> directly.
            </p>
          </form>
        ) : (
          <div class="form-fallback">
            <h2>Email us directly</h2>
            <p class="muted" style="margin-top: var(--space-4)">
              The workflow review form is not connected yet, so rather than show you a form
              that goes nowhere, here is the direct route:
            </p>
            <p class="fallback-email">
              <a href={`mailto:${email}?subject=Workflow%20review%20request`}>{email}</a>
            </p>
            <p class="muted small" style="margin-top: var(--space-5)">Helpful to include:</p>
            <ul class="card-list">
              <li>Your role</li>
              <li>The task you would hand off first</li>
              <li>The tools you use today</li>
              <li>Roughly how many hours a week it costs you</li>
              <li>The result that would make fixing it worthwhile</li>
            </ul>
            <p class="safety-note small">Do not email passwords, access codes, financial account numbers, or sensitive records.</p>
            <!--
              To enable the form: set PUBLIC_FORM_ENDPOINT in the Cloudflare Pages
              environment variables and redeploy. Provider options and their privacy
              tradeoffs are in the ops repo, DECISIONS.md D-04.
            -->
          </div>
        )}
      </div>
    </div>
  </section>
</Base>

{configured && (
  <script is:inline src="/scripts/contact.js" defer></script>
)}

<style>
  .form-layout {
    display: grid;
    gap: var(--space-7);
    grid-template-columns: 1fr;
    align-items: start;
  }

  .form-intro h1 { max-width: 14ch; }

  @media (min-width: 54em) {
    .form-layout { grid-template-columns: 1fr 1fr; gap: var(--space-8); }
  }

  .intro-h {
    font-size: var(--text-xs);
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--ink-faint);
    margin-top: var(--space-7);
    margin-bottom: var(--space-4);
  }

  .next-steps {
    padding-left: var(--space-5);
    max-width: var(--measure);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
  .next-steps li + li { margin-top: var(--space-2); }

  .safety-note {
    margin-top: var(--space-5);
    padding: var(--space-4);
    color: var(--ink-muted);
    background: var(--ground-sunken);
    border-left: var(--border-thick) solid var(--secondary);
    border-radius: var(--radius);
  }

  .form-panel {
    background: var(--ground-raised);
    border: var(--border-thin) solid var(--rule);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow);
  }

  .form-note { color: var(--ink-faint); margin-bottom: var(--space-5); }

  .field + .field { margin-top: var(--space-5); }

  .consent-field {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    margin-top: var(--space-5);
  }

  .consent-field input { width: 1.1rem; min-height: 1.1rem; margin-top: 0.2rem; }
  .consent-field label { margin: 0; color: var(--ink-muted); }

  label {
    display: block;
    font-weight: 600;
    font-size: var(--text-sm);
    margin-bottom: var(--space-2);
  }

  .req { color: var(--accent-text); }
  .optional { font-weight: 400; color: var(--ink-faint); }

  .hint {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    margin-bottom: var(--space-2);
    margin-top: calc(var(--space-1) * -1);
  }

  input,
  textarea,
  select {
    width: 100%;
    padding: var(--space-3);
    min-height: 44px;
    background: var(--ground);
    border: var(--border-thin) solid var(--rule-strong);
    border-radius: var(--radius);
    font-size: var(--text-base);
    transition: border-color var(--transition), box-shadow var(--transition);
  }

  textarea { resize: vertical; line-height: var(--leading-snug); }

  input:focus,
  textarea:focus,
  select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 var(--focus-width) var(--accent-ring);
  }

  /* Only style invalid fields after the user has engaged with them — colouring an
     untouched empty required field red is hostile. */
  input:user-invalid,
  textarea:user-invalid {
    border-color: var(--danger);
  }

  .form-submit {
    width: 100%;
    margin-top: var(--space-6);
  }

  .form-submit:disabled { opacity: 0.65; cursor: wait; }

  .form-status {
    margin-top: var(--space-4);
    padding: var(--space-3);
    border-radius: var(--radius);
    color: var(--ink-muted);
    background: var(--ground-sunken);
  }
  .form-status.is-success { border-left: var(--border-thick) solid var(--ok); color: var(--ink); }
  .form-status.is-error { border-left: var(--border-thick) solid var(--danger); }

  .trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .form-fallback h2 { font-size: var(--text-xl); }

  .fallback-email {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    font-weight: 600;
  }
</style>
