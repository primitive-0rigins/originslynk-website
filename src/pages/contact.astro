---
import Base from '../layouts/Base.astro';

const defaultEndpoint = 'https://originslynk-contact.primitive-origins.workers.dev';
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT || defaultEndpoint;
const email = import.meta.env.PUBLIC_CONTACT_EMAIL || 'bryce@originslynk.com';
const configured = endpoint.length > 0;
---

<Base
  title="Request a workflow review"
  description="Request an OriginsLynk discovery consultation about a repetitive business task, current software, operating boundaries, and the appropriate service tier."
>
  <section class="section-cream contact-section">
    <div class="container form-layout">
      <div class="form-intro">
        <p class="eyebrow">Workflow review</p>
        <h1>Start with the work you want off your mind.</h1>
        <p class="lede">
          A few practical details are enough. We will identify a useful first workflow,
          recommend the right service level, and explain what should remain human-approved.
        </p>

        <h2 class="intro-h">What happens next</h2>
        <ol class="next-steps">
          <li>We review your request and reply within one business day.</li>
          <li>A discovery call maps the current process and its first useful workflow.</li>
          <li>You receive a written scope, price, responsibilities, and support period.</li>
        </ol>

        <div class="form-boundary">
          <p><strong>Keep sensitive information out of this form.</strong></p>
          <p>
            Do not submit passwords, API keys, private client records, financial account
            details, health information, or other sensitive credentials through this form.
            Account access is handled separately after a project is approved.
          </p>
          <a href="/trust#data-handling">How OriginsLynk handles access and information →</a>
        </div>
      </div>

      <div class="form-panel">
        <form
          action={configured ? endpoint : '/contact'}
          method="POST"
          class="form"
          data-consultation-form
          data-form-mode={configured ? 'endpoint' : 'email'}
          data-contact-email={email}
        >
          <div class="form-heading">
            <p class="eyebrow">Tell us about the work</p>
            <h2>Workflow review request</h2>
            <p class="form-note small">
              {configured
                ? 'Your request will be sent securely. Required fields are marked with an asterisk.'
                : 'Complete the form and we will prepare an addressed email for you to review and send. Required fields are marked with an asterisk.'}
            </p>
          </div>

          <fieldset>
            <legend><span>01</span> About you</legend>
            <div class="field-grid">
              <div class="field">
                <label for="name">Full name <span class="req" aria-hidden="true">*</span></label>
                <input type="text" id="name" name="name" required autocomplete="name" maxlength="100" />
              </div>

              <div class="field">
                <label for="email">Work email <span class="req" aria-hidden="true">*</span></label>
                <input type="email" id="email" name="email" required autocomplete="email" maxlength="160" />
              </div>

              <div class="field">
                <label for="phone">Phone <span class="optional">(optional)</span></label>
                <input type="tel" id="phone" name="phone" autocomplete="tel" maxlength="40" />
              </div>

              <div class="field">
                <label for="organization">Business name <span class="req" aria-hidden="true">*</span></label>
                <input type="text" id="organization" name="organization" required autocomplete="organization" maxlength="140" />
              </div>

              <div class="field">
                <label for="industry">Industry <span class="req" aria-hidden="true">*</span></label>
                <input type="text" id="industry" name="industry" required maxlength="120" placeholder="Professional services, construction, retail…" />
              </div>

              <div class="field">
                <label for="role">Your role <span class="req" aria-hidden="true">*</span></label>
                <input
                  type="text"
                  id="role"
                  name="role"
                  required
                  autocomplete="organization-title"
                  maxlength="120"
                  placeholder="Marketing director, office manager, owner…"
                />
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend><span>02</span> The work to improve</legend>
            <div class="field">
              <label for="problem">Main repetitive task or workflow <span class="req" aria-hidden="true">*</span></label>
              <p class="hint" id="problem-hint">Describe the steps and friction in plain language without including private records.</p>
              <textarea id="problem" name="problem" rows="5" required maxlength="1200" aria-describedby="problem-hint"></textarea>
            </div>

            <div class="field">
              <label for="tools">Current software or accounts involved <span class="req" aria-hidden="true">*</span></label>
              <p class="hint" id="tools-hint">List product categories or account names only—never passwords, keys, or access codes.</p>
              <textarea id="tools" name="tools" rows="3" required maxlength="500" aria-describedby="tools-hint"></textarea>
            </div>

            <div class="field">
              <label for="hours">Approximate hours spent each week <span class="req" aria-hidden="true">*</span></label>
              <select id="hours" name="hours" required>
                <option value="">Select a range</option>
                <option value="Less than 2 hours">Less than 2 hours</option>
                <option value="2–5 hours">2–5 hours</option>
                <option value="6–10 hours">6–10 hours</option>
                <option value="11–20 hours">11–20 hours</option>
                <option value="More than 20 hours">More than 20 hours</option>
              </select>
            </div>
          </fieldset>

          <fieldset>
            <legend><span>03</span> Safeguards and scheduling</legend>
            <div class="field">
              <label for="sensitivity">Does this work involve sensitive or regulated information? <span class="req" aria-hidden="true">*</span></label>
              <select id="sensitivity" name="sensitivity" required>
                <option value="">Select one</option>
                <option value="No sensitive or regulated information known">No sensitive or regulated information known</option>
                <option value="Sensitive or confidential business information">Sensitive or confidential business information</option>
                <option value="Financial information">Financial information</option>
                <option value="Health information">Health information</option>
                <option value="Legal information">Legal information</option>
                <option value="Other regulated or high-risk information">Other regulated or high-risk information</option>
                <option value="Not sure">Not sure</option>
              </select>
            </div>

            <div class="field">
              <label for="timeline">Preferred consultation time <span class="req" aria-hidden="true">*</span></label>
              <p class="hint" id="timeline-hint">Give a few days or time windows and include your time zone.</p>
              <input type="text" id="timeline" name="timeline" required maxlength="160" aria-describedby="timeline-hint" placeholder="Weekday mornings, Eastern time" />
            </div>

            <div class="field">
              <label for="service">Service you are considering <span class="optional">(optional)</span></label>
              <select id="service" name="service">
                <option value="">Not sure yet</option>
                <option value="personal-ai-agent-setup">$750 Personal AI Agent Setup</option>
                <option value="role-automation-system">$1,200 Role Automation System</option>
                <option value="managed-automation-appliance">Managed Automation Appliance from $2,800 plus $250/month</option>
              </select>
            </div>
          </fieldset>

          <div class="consent-field">
            <input type="checkbox" id="consent" name="consent" value="yes" required />
            <label for="consent">
              I consent to OriginsLynk contacting me about this request and using the
              submitted information as described in the Privacy Policy.
              <span class="req" aria-hidden="true">*</span>
              <a href="/privacy">Read the Privacy Policy.</a>
            </label>
          </div>

          <div class="trap" aria-hidden="true">
            <label for="company-website">Leave this field empty</label>
            <input type="text" id="company-website" name="company_website" tabindex="-1" autocomplete="off" />
          </div>

          <button type="submit" class="btn btn-primary form-submit">
            {configured ? 'Request a workflow review' : 'Prepare my request'}
          </button>

          <p id="form-status" class="form-status small" role="status" aria-live="polite" hidden></p>
          <a id="prepared-email" class="btn btn-secondary prepared-email" href={`mailto:${email}`} hidden>Open prepared email</a>

          <p class="direct-email small muted">
            Prefer a blank email? Write to <a href={`mailto:${email}?subject=Workflow%20review%20request`}>{email}</a>.
          </p>
        </form>
      </div>
    </div>
  </section>
</Base>

<script is:inline src="/scripts/contact.js" defer></script>

<style>
  .contact-section { padding-block: clamp(3.25rem, 6vw, var(--space-8)); }
  .form-layout { display: grid; gap: var(--space-7); align-items: start; }
  .form-intro h1 { max-width: 13ch; }
  .form-intro > .lede { margin-top: var(--space-5); max-width: 52ch; }

  .intro-h {
    margin: var(--space-7) 0 var(--space-4);
    color: var(--ink-faint);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .next-steps { padding-left: var(--space-5); color: var(--ink-muted); font-size: var(--text-sm); }
  .next-steps li + li { margin-top: var(--space-2); }

  .form-boundary {
    margin-top: var(--space-6);
    padding: var(--space-5);
    background: var(--ground-sunken);
    border-left: var(--border-thick) solid var(--secondary);
    border-radius: var(--radius);
  }
  .form-boundary p { color: var(--ink-muted); font-size: var(--text-sm); }
  .form-boundary p + p { margin-top: var(--space-2); }
  .form-boundary strong { color: var(--ink); }
  .form-boundary a { display: inline-block; margin-top: var(--space-3); font-size: var(--text-xs); font-weight: 680; text-decoration: none; }

  .form-panel {
    background: var(--ground-raised);
    border: var(--border-thin) solid var(--rule);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 4vw, var(--space-7));
    box-shadow: var(--shadow);
  }
  .form-heading { padding-bottom: var(--space-5); border-bottom: var(--border-thin) solid var(--rule); }
  .form-heading h2 { font-size: var(--text-2xl); }
  .form-note { color: var(--ink-faint); margin-top: var(--space-3); }

  fieldset { padding: 0; border: 0; margin-top: var(--space-7); }
  legend { width: 100%; margin-bottom: var(--space-5); color: var(--ink); font-size: var(--text-sm); font-weight: 720; letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  legend span { color: var(--accent-text); margin-right: var(--space-2); }
  .field-grid { display: grid; gap: var(--space-5); }
  .field + .field, .field-grid + .field, .field + .field-grid { margin-top: var(--space-5); }

  label { display: block; margin-bottom: var(--space-2); font-size: var(--text-sm); font-weight: 600; }
  .req { color: var(--accent-text); }
  .optional { color: var(--ink-faint); font-weight: 400; }
  .hint { margin: calc(var(--space-1) * -1) 0 var(--space-2); color: var(--ink-faint); font-size: var(--text-xs); }

  input, textarea, select {
    width: 100%;
    min-height: 46px;
    padding: var(--space-3);
    background: var(--ground);
    border: var(--border-thin) solid var(--rule-strong);
    border-radius: var(--radius);
    font-size: var(--text-base);
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  textarea { resize: vertical; line-height: var(--leading-snug); }
  input:focus, textarea:focus, select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 var(--focus-width) var(--accent-ring); }
  input:user-invalid, textarea:user-invalid, select:user-invalid { border-color: var(--danger); }

  .consent-field { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start; margin-top: var(--space-7); }
  .consent-field input { width: 1.1rem; min-height: 1.1rem; margin-top: .2rem; }
  .consent-field label { margin: 0; color: var(--ink-muted); }
  .form-submit, .prepared-email { width: 100%; margin-top: var(--space-5); }
  .form-submit:disabled { opacity: .65; cursor: wait; }

  .form-status { margin-top: var(--space-4); padding: var(--space-3); border-radius: var(--radius); color: var(--ink-muted); background: var(--ground-sunken); }
  .form-status.is-success { border-left: var(--border-thick) solid var(--ok); color: var(--ink); }
  .form-status.is-error { border-left: var(--border-thick) solid var(--danger); }
  .direct-email { margin-top: var(--space-4); }

  .trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  @media (min-width: 42em) {
    .field-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 64em) {
    .form-layout { grid-template-columns: .8fr 1.2fr; gap: var(--space-8); }
    .form-intro { position: sticky; top: calc(var(--space-8) + var(--space-5)); }
  }
</style>
