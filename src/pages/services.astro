---
import Base from '../layouts/Base.astro';
import ApplianceVisual from '../components/ApplianceVisual.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { managedAutomation, personalAgentSetup, roleAutomationSystem } from '../data/services';

const progression = [personalAgentSetup, roleAutomationSystem, managedAutomation];

const examples = [
  'Preparing email drafts for approval',
  'Summarizing incoming information',
  'Organizing follow-up tasks',
  'Creating recurring reports',
  'Updating approved business records',
  'Preparing marketing content for review',
  'Collecting information from supported systems',
  'Routing exceptions to a person',
  'Tracking routine operational work',
];
---

<Base
  title="Services"
  description="Compare Personal AI Agent Setup, Role Automation System, and the OriginsLynk-managed dedicated automation appliance."
>
  <section class="section-cream page-hero">
    <div class="container container-narrow">
      <p class="eyebrow">Services</p>
      <h1>Three levels of implementation and operational support.</h1>
      <p class="lede">
        OriginsLynk builds configured business systems—not access to a named AI product.
        Choose the level based on who should start the work, operate the workflows, and
        maintain the environment after launch.
      </p>
    </div>
  </section>

  <section class="progression-section" aria-labelledby="progression-title">
    <div class="container">
      <div class="section-head section-head-center">
        <p class="eyebrow">Service progression</p>
        <h2 id="progression-title">You direct it → You operate it → We maintain it</h2>
        <p class="muted">The system becomes deeper and OriginsLynk takes on more operational responsibility at each level.</p>
      </div>
      <ol class="progression">
        {progression.map((service, index) => (
          <li>
            <span aria-hidden="true">0{index + 1}</span>
            <strong>{service.shortLabel}</strong>
            <p>{service.name}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-sunken service-sections">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What each service includes</p>
        <h2>Scope and responsibility, side by side.</h2>
        <p class="muted">Each section states what is built, what you operate, what OriginsLynk supports, and what remains outside the price.</p>
      </div>
      <div class="service-list">
        <ServiceCard service={personalAgentSetup} label="Tier 1 · You direct it" featured details />
        <ServiceCard service={roleAutomationSystem} label="Tier 2 · You operate it" details />
        <ServiceCard service={managedAutomation} label="Tier 3 · We maintain it" details />
      </div>
    </div>
  </section>

  <section id="managed-appliance" class="section-dark appliance-section">
    <div class="container appliance-grid">
      <div>
        <p class="eyebrow">Managed appliance, in plain language</p>
        <h2>A dedicated small computer at your location.</h2>
        <p class="lede appliance-intro">
          OriginsLynk owns the appliance and remotely manages the agreed workflow
          environment on it. It is dedicated to one client and is not shared with another
          business.
        </p>
        <ul class="checklist appliance-list">
          <li>You provide power, internet connectivity, and reasonable physical access.</li>
          <li>Your accounts and business data remain yours.</li>
          <li>You authorize account access through the approved onboarding process.</li>
          <li>The appliance is returned when managed service ends.</li>
          <li>Offboarding, access removal, and available exports follow the service agreement.</li>
          <li>The environment may depend on third-party services whose availability and terms can change.</li>
        </ul>
        <p class="small appliance-note">
          The public site does not promise a hardware model or internal infrastructure
          design. The supplied device is selected for the agreed workload and availability.
        </p>
      </div>
      <ApplianceVisual />
    </div>
  </section>

  <section id="examples">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Example workflows</p>
        <h2>Practical work a system may help prepare or route.</h2>
        <p class="muted">Examples are evaluated during discovery and are not automatically included in every package.</p>
      </div>
      <div class="example-grid">
        {examples.map((example) => <p>{example}</p>)}
      </div>
    </div>
  </section>

  <section class="section-sunken integration-section">
    <div class="container container-narrow">
      <p class="eyebrow">Supported business integrations</p>
      <h2>Connections are evaluated during discovery.</h2>
      <p class="lede">
        OriginsLynk prioritizes official APIs, supported connectors, and documented
        authorization methods. Unstable, undocumented, or unusually complex connections
        may be declined, treated as experimental, or quoted separately.
      </p>
      <p class="muted disclosure">
        OriginsLynk configures and manages systems that may use selected third-party
        software, AI services, integrations, and infrastructure. Specific providers may
        change according to compatibility, availability, security, and client requirements.
      </p>
      <div class="btn-row">
        <a href="/contact" class="btn btn-primary">Request a discovery consultation</a>
        <a href="/pricing" class="btn btn-secondary">Review pricing</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero h1 { max-width: 16ch; }
  .page-hero .lede { max-width: 62ch; margin-top: var(--space-5); }

  .progression-section { padding-block: clamp(3.5rem, 6vw, var(--space-8)); }
  .progression { display: grid; gap: var(--space-4); list-style: none; padding: 0; }
  .progression li { position: relative; padding: var(--space-5); border-top: var(--border-thick) solid var(--accent); background: var(--ground-raised); }
  .progression li > span { color: var(--accent-text); font-size: var(--text-xs); font-weight: 720; }
  .progression strong, .progression p { display: block; }
  .progression strong { margin-top: var(--space-4); font-size: var(--text-lg); }
  .progression p { margin-top: var(--space-2); color: var(--ink-muted); font-size: var(--text-sm); }

  .service-list { display: grid; gap: var(--space-6); }
  .service-list > :global(article) { scroll-margin-top: 7rem; }

  .appliance-grid { display: grid; gap: var(--space-8); align-items: center; }
  .appliance-intro { margin-top: var(--space-5); }
  .appliance-list { margin-top: var(--space-6); }
  .appliance-list li { color: var(--ink-inverse-muted); }
  .appliance-list li::before { border-color: #a9c99e; }
  .appliance-note { margin-top: var(--space-6); color: var(--ink-inverse-muted); }

  .example-grid { display: grid; gap: var(--space-3); }
  .example-grid p { padding: var(--space-4); border-left: var(--border-thick) solid var(--accent); background: var(--ground-sunken); color: var(--ink-muted); font-size: var(--text-sm); }

  .integration-section .lede { margin-top: var(--space-4); }
  .integration-section .disclosure { margin-top: var(--space-5); }

  @media (min-width: 42em) {
    .progression { grid-template-columns: repeat(3, 1fr); }
    .example-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 64em) {
    .appliance-grid { grid-template-columns: 1fr 1fr; }
    .example-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
