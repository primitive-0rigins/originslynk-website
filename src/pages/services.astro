---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { healthCheck, implementationServices } from '../data/services';

const examples = [
  ['Lead and request follow-up', 'Capture the request, prepare the next step, and keep exceptions visible.'],
  ['Recurring reports', 'Gather and organize approved information so review starts with a useful draft.'],
  ['Document preparation', 'Turn consistent inputs into repeatable drafts, summaries, checklists, or packets.'],
  ['Inbox and form triage', 'Sort incoming information and route it to the right person or next action.'],
  ['Task and record updates', 'Prepare routine updates while keeping consequential changes human-approved.'],
  ['Existing automation repair', 'Identify silent failures, unclear ownership, waste, and the safest repair order.'],
];
---

<Base
  title="Services"
  description="Clear OriginsLynk services for diagnosing broken automation and removing repetitive business work with two, four, or six total workflows."
>
  <section class="section-cream page-hero">
    <div class="container container-narrow">
      <p class="eyebrow">Services</p>
      <h1>Tell us what is slowing the business down. We will tell you what to do next.</h1>
      <p class="lede">Start with a diagnosis when an existing system is unreliable. Start with Tier 1 when the work is still manual. Add complexity only after the first workflows prove useful.</p>
    </div>
  </section>

  <section class="diagnostic-section">
    <div class="container split-head">
      <div>
        <p class="eyebrow">When something already exists</p>
        <h2>Diagnose before you repair.</h2>
        <p class="lede">An automation that “mostly works” can hide failed handoffs, duplicate costs, risky access, and work nobody owns.</p>
      </div>
      <ServiceCard service={healthCheck} featured details />
    </div>
  </section>

  <section class="section-sunken">
    <div class="container">
      <div class="section-head section-head-center">
        <p class="eyebrow">When you need a system built</p>
        <h2>Three cumulative levels, one clear path.</h2>
        <p class="muted">Tier 2 includes Tier 1. Tier 3 includes Tiers 1 and 2. Compatible completed work is credited when you upgrade.</p>
      </div>
      <div class="service-list">
        {implementationServices.map((service, index) => (
          <ServiceCard service={service} label={`Tier ${index + 1} · ${index === 0 ? 'You direct it' : index === 1 ? 'You operate it' : 'We maintain it'}`} featured={index === 0} details />
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What this can look like</p>
        <h2>Business work in. Prepared next step out.</h2>
        <p class="muted">The exact workflow depends on your process, accounts, risk, and volume. These examples show the kind of friction we look for.</p>
      </div>
      <div class="example-grid">
        {examples.map(([title, body]) => <article><h3>{title}</h3><p>{body}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section-dark boundary-section">
    <div class="container boundary-grid">
      <div>
        <p class="eyebrow">No mystery box</p>
        <h2>You will know what the system does—and what it does not do.</h2>
      </div>
      <div>
        <ul class="checklist">
          <li>The trigger, inputs, outputs, approval point, and owner are written down.</li>
          <li>We use supported connections and narrow, revocable access.</li>
          <li>Consequential messages and record changes remain human-approved unless separately authorized in writing.</li>
          <li>Required subscriptions and outside provider charges are disclosed before onboarding.</li>
        </ul>
        <div class="btn-row">
          <a href="/contact" class="btn btn-primary">Request a service</a>
          <a href="/pricing" class="btn btn-secondary">Compare pricing</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero h1 { max-width: 18ch; }
  .page-hero .lede { margin-top: var(--space-5); }
  .split-head { display: grid; gap: var(--space-8); align-items: start; }
  .split-head > div h2 { max-width: 12ch; }
  .split-head > div .lede { margin-top: var(--space-5); }
  .service-list { display: grid; gap: var(--space-5); }
  .example-grid { display: grid; gap: var(--space-4); }
  .example-grid article { padding: var(--space-5); border: 1px solid var(--rule); border-radius: var(--radius); background: var(--ground-raised); }
  .example-grid h3 { font-size: var(--text-lg); }
  .example-grid p { margin-top: var(--space-3); color: var(--ink-muted); font-size: var(--text-sm); }
  .boundary-grid { display: grid; gap: var(--space-8); }
  .boundary-grid h2 { max-width: 15ch; }
  .section-dark .checklist li { color: var(--ink-inverse-muted); }
  .section-dark .checklist li::before { border-color: #8fd0c6; }
  @media (min-width: 42em) {
    .example-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 64em) {
    .split-head { grid-template-columns: .8fr 1.2fr; }
    .service-list { grid-template-columns: repeat(3, 1fr); }
    .example-grid { grid-template-columns: repeat(3, 1fr); }
    .boundary-grid { grid-template-columns: .9fr 1.1fr; }
  }
</style>
