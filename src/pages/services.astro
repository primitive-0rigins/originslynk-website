---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import {
  assistantRoleSystem,
  managedAutomation,
  personalAssistantStarter,
} from '../data/services';

const roles = [
  {
    role: 'Marketing director',
    items: [
      'Campaign brief intake and asset-request routing',
      'Content calendar preparation',
      'Performance-summary drafts',
      'Missing asset and approval tracking',
    ],
  },
  {
    role: 'Real-estate professional',
    items: [
      'Lead context prepared before you call',
      'Follow-up drafts waiting for your approval',
      'Appointment preparation summaries',
      'Alerts on conversations that have gone quiet',
      'Daily priority summary',
    ],
  },
  {
    role: 'Administrator',
    items: [
      'Inbox triage and draft queue',
      'Meeting preparation',
      'Document intake and filing',
      'Weekly status reporting and deadline reminders',
    ],
  },
  {
    role: 'Virtual assistant',
    items: [
      'Lead research and follow-up preparation',
      'Client onboarding checklists',
      'Content repurposing',
      'Appointment and travel preparation',
    ],
  },
  {
    role: 'Small-business operator',
    items: [
      'Daily priority brief and inquiry routing',
      'Estimate or proposal preparation',
      'Overdue follow-up list',
      'Operating-report preparation',
    ],
  },
  {
    role: 'Office manager',
    items: [
      'Vendor and supply reminders',
      'Staff onboarding checklists',
      'Maintenance issue routing',
      'Recurring policy and document review',
    ],
  },
];
---

<Base
  title="Services"
  description="Personal AI Assistant Setup from $750, a four-workflow role system, and a dedicated Managed Automation Appliance."
>
  <section class="section-cream page-hero">
    <div class="container container-narrow">
      <p class="eyebrow">Services</p>
      <h1>Three ways to recover time, with clear operating boundaries.</h1>
      <p class="lede" style="margin-top: var(--space-5)">
        Start with a supervised workspace you operate yourself, expand it around your
        role, or move proven recurring work into managed infrastructure.
      </p>
    </div>
  </section>

  <!-- ============ SERVICE LADDER ============ -->
  <section class="section-sunken">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Service ladder</p>
        <h2>Choose based on who operates the system.</h2>
        <p class="muted">The $750 Assistant Setup and $1,200 AI Workflow System are client-operated. The Managed Automation Appliance is monitored and maintained by OriginsLynk.</p>
      </div>
      <div class="service-grid">
        <ServiceCard service={personalAssistantStarter} label="Service one · start here" featured details />
        <ServiceCard service={assistantRoleSystem} label="Service two · expand the role" details />
        <ServiceCard service={managedAutomation} label="Service three · proven recurring work" details />
      </div>
      <div class="separation-note">
        <p><strong>The first two services remain yours to operate.</strong> Choose the appliance only when proven recurring work needs a dedicated environment, monitoring, backups, and ongoing care.</p>
      </div>
    </div>
  </section>

  <!-- ============ EXAMPLE ROLE SYSTEMS ============ -->
  <section id="use-cases">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Example role systems</p>
        <h2>What this looks like for a specific job.</h2>
        <p class="muted">
          These are examples, not a fixed menu. The best first workflow is frequent,
          time-consuming, predictable, and easy for a person to verify.
        </p>
      </div>

      <div class="grid">
        {roles.map((r) => (
          <article class="card card-accent">
            <h3>{r.role}</h3>
            <ul class="card-list">
              {r.items.map((i) => <li>{i}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ UPGRADE PATH ============ -->
  <section class="section-dark upgrade-section">
    <div class="container container-narrow">
      <p class="eyebrow">The path between them</p>
      <h2>Automate the thing you got tired of starting yourself.</h2>
      <p class="muted" style="margin-top: var(--space-4)">
        The personal assistant tends to reveal which tasks you still have to remember to
        begin. Those are the honest candidates for automation — chosen from observed
        friction, not from a sales conversation.
      </p>

      <ol class="path">
        <li><strong>Personal AI Assistant Setup.</strong> Two guided workflows teach you what is useful and what still needs review.</li>
        <li><strong>AI Workflow System.</strong> Four workflows organize recurring work around one person and one role.</li>
        <li><strong>Managed Automation Appliance.</strong> Six configured workflows, including no more than two active automations, run in a dedicated environment.</li>
        <li><strong>Measured expansion.</strong> Add only the workflows that prove their value in real use.</li>
      </ol>

      <p class="small muted" style="margin-top: var(--space-6)">
        There is no requirement to move up this list, and no discount for doing it faster.
        Plenty of people should stop at step one.
      </p>

      <div class="btn-row">
        <a href="/pricing" class="btn btn-primary">See pricing</a>
        <a href="/contact" class="btn btn-secondary">Request a workflow review</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: stretch;
  }

  .separation-note {
    margin-top: var(--space-6);
    padding: var(--space-5);
    background: var(--ground-raised);
    border: var(--border-thin) solid var(--rule);
    border-left: var(--border-thick) solid var(--accent);
    border-radius: var(--radius);
  }

  .separation-note p { color: var(--ink-muted); max-width: 84ch; }
  .separation-note strong { color: var(--ink); }

  .page-hero h1 { max-width: 16ch; }
  .page-hero .lede { max-width: 56ch; }

  #use-cases .grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  #use-cases .card { box-shadow: none; }

  .upgrade-section .path li { color: var(--ink-inverse-muted); border-left-color: var(--rule-inverse); }
  .upgrade-section .path li::before {
    background: var(--ground-inverse);
    border-color: rgba(255,255,255,.32);
    color: var(--ink-inverse-muted);
  }
  .upgrade-section .path strong { color: var(--ink-inverse); }
  .upgrade-section .small { color: var(--ink-inverse-muted); }

  @media (min-width: 64em) {
    .service-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .path {
    counter-reset: path;
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
    max-width: var(--measure);
  }

  .path li {
    counter-increment: path;
    position: relative;
    padding-left: var(--space-7);
    padding-bottom: var(--space-5);
    border-left: var(--border-thin) solid var(--rule-strong);
    margin-left: 11px;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .path li:last-child { border-left-color: transparent; padding-bottom: 0; }

  .path li::before {
    content: counter(path);
    position: absolute;
    left: -11px;
    top: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--ground);
    border: var(--border-thin) solid var(--rule-strong);
    color: var(--ink-faint);
    font-size: var(--text-xs);
    font-weight: 650;
    display: grid;
    place-items: center;
  }

  .path strong { color: var(--ink); }
</style>
