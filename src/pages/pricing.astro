---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import {
  assistantRoleSystem,
  managedAutomation,
  personalAssistantStarter,
} from '../data/services';

const comparison = [
  {
    service: personalAssistantStarter.name,
    operator: 'You',
    workflows: '2 guided workflows',
    support: '14 days',
    ongoing: 'None required',
  },
  {
    service: assistantRoleSystem.name,
    operator: 'You',
    workflows: '4 role workflows',
    support: '30 days',
    ongoing: 'None required',
  },
  {
    service: managedAutomation.name,
    operator: 'OriginsLynk',
    workflows: '6 total; up to 2 active',
    support: '30-day launch period',
    ongoing: '$250/month',
  },
];
---

<Base
  title="Pricing"
  description="OriginsLynk pricing: $750 Personal AI Assistant Setup, $1,200 AI Workflow System, and a Managed Automation Appliance starting at $2,800 plus $250 per month."
>
  <section class="section-cream page-hero">
    <div class="container container-narrow">
      <p class="eyebrow">Pricing</p>
      <h1>Three clear levels, based on who keeps the work running.</h1>
      <p class="lede" style="margin-top: var(--space-5)">
        Start with two guided workflows, expand one role to four, or place proven recurring
        work on a dedicated managed appliance. Your accounts, subscriptions, and usage
        charges remain yours.
      </p>
    </div>
  </section>

  <section class="section-sunken pricing-cards">
    <div class="container">
      <div class="service-grid">
        <ServiceCard service={personalAssistantStarter} label="Start here" featured details />
        <ServiceCard service={assistantRoleSystem} label="Build around one role" details />
        <ServiceCard service={managedAutomation} label="Keep proven work running" details />
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">At a glance</p>
        <h2>The operating difference between each service.</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">Service</th>
              <th scope="col">Day-to-day operator</th>
              <th scope="col">Included workflows</th>
              <th scope="col">Stabilization</th>
              <th scope="col">Ongoing cost</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <th scope="row">{row.service}</th>
                <td>{row.operator}</td>
                <td>{row.workflows}</td>
                <td>{row.support}</td>
                <td>{row.ongoing}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="care-plan" class="section-dark care-section">
    <div class="container">
      <div class="two-col">
        <div>
          <p class="eyebrow">Appliance Care Plan</p>
          <h2>$250 per month after the launch period.</h2>
          <p class="muted care-intro">
            The appliance remains OriginsLynk property and is rented as part of the managed
            service. The monthly plan keeps the agreed system maintained; it is not an
            unlimited development retainer.
          </p>
          <ul class="checklist" style="margin-top: var(--space-5)">
            <li>Dedicated appliance rental</li>
            <li>Automated health monitoring</li>
            <li>Software and security updates</li>
            <li>Configuration backup checks</li>
            <li>Break/fix support during business hours</li>
            <li>Monthly activity report</li>
            <li>Up to 60 minutes of minor adjustments</li>
          </ul>
          <p class="small muted monthly-note">
            Unused adjustment time does not roll over. Response targets are goals, not an
            uptime guarantee. Internet, power, account availability, and outside providers
            remain outside OriginsLynk's control.
          </p>
        </div>

        <div>
          <p class="eyebrow">Add-on work</p>
          <h2>$300 for an additional templated workflow.</h2>
          <p class="muted care-intro">
            That price applies when the new workflow uses your existing setup, supported
            account connections, and an established OriginsLynk template.
          </p>
          <ul class="checklist" style="margin-top: var(--space-5)">
            <li>One clear trigger and outcome</li>
            <li>Limited branching and exception handling</li>
            <li>No more than two existing systems</li>
            <li>A defined human approval point</li>
            <li>No substantial custom development</li>
          </ul>
          <div class="quote-note">
            <p>
              <strong>More complex work is quoted from $500–$1,500+.</strong> New account
              connections, advanced authentication, several branches or users, document
              extraction, data migration, dashboards, and high-risk actions require discovery.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container container-narrow">
      <p class="eyebrow">What happens before you buy</p>
      <h2>Scope first, then a written price.</h2>
      <p class="lede" style="margin-top: var(--space-4)">
        We map the current process, decide what should remain human-approved, and write down
        the included workflows, responsibilities, support period, and outside costs before
        implementation begins.
      </p>
      <div class="btn-row">
        <a href="/contact" class="btn btn-primary">Request a workflow review</a>
        <a href="/faq" class="btn btn-secondary">Read common questions</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    align-items: stretch;
  }

  .table-wrap {
    width: 100%;
    overflow-x: auto;
    border: var(--border-thin) solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--ground-raised);
  }

  table { width: 100%; border-collapse: collapse; min-width: 46rem; }
  th, td { padding: var(--space-4); text-align: left; border-bottom: var(--border-thin) solid var(--rule); vertical-align: top; }
  thead th { color: var(--ink-faint); font-size: var(--text-xs); letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  tbody th { color: var(--ink); font-size: var(--text-sm); }
  tbody td { color: var(--ink-muted); font-size: var(--text-sm); }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }

  .two-col { display: grid; grid-template-columns: 1fr; gap: var(--space-8); }
  .care-intro, .monthly-note { margin-top: var(--space-4); }

  .quote-note {
    margin-top: var(--space-6);
    padding: var(--space-5);
    border-left: var(--border-thick) solid var(--accent);
    background: var(--ground-raised);
    border-radius: var(--radius);
  }
  .quote-note p { color: var(--ink-muted); }
  .quote-note strong { color: var(--ink); }

  .page-hero h1 { max-width: 16ch; }
  .page-hero .lede { max-width: 58ch; }
  .care-section .checklist li { color: var(--ink-inverse-muted); }
  .care-section .checklist li::before { border-color: #a9c99e; }
  .care-section .quote-note { background: rgba(255,255,255,.06); border-color: #a9c99e; }
  .care-section .quote-note p { color: var(--ink-inverse-muted); }
  .care-section .quote-note strong { color: var(--ink-inverse); }

  @media (min-width: 64em) {
    .service-grid { grid-template-columns: repeat(3, 1fr); }
    .two-col { grid-template-columns: 1fr 1fr; }
  }
</style>
