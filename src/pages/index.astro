---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { tier1Setup, tier2Setup, tier3Setup } from '../data/services';

const painPoints = [
  ['Follow-up lives in someone’s memory', 'Requests wait, leads cool off, and the team has to ask what happened.'],
  ['The same information gets copied twice', 'Details move by hand between email, forms, documents, and business systems.'],
  ['Reports are rebuilt from scratch', 'Hours disappear into gathering, sorting, formatting, and checking the same information.'],
  ['Existing automation cannot be trusted', 'It fails quietly, has no clear owner, or costs money without saving dependable time.'],
];

const outcomes = [
  ['01', 'Show us the drag', 'Tell us what repeats, breaks, or keeps following you home.'],
  ['02', 'See the right first move', 'We map the process and recommend the smallest useful service.'],
  ['03', 'Get a system you understand', 'We build, test, document, and train around your actual work.'],
];
---

<Base
  title="OriginsLynk"
  description="OriginsLynk removes repetitive business work by building clear, dependable workflow systems around the way your team already works."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Practical workflow systems for small business</p>
        <h1>Stop rebuilding the same work <em>every week.</em></h1>
        <p class="lede">
          OriginsLynk finds the repetitive work draining your time and turns the right
          parts into clear, dependable systems—without taking important decisions away
          from you.
        </p>
        <div class="btn-row">
          <a href="/contact" class="btn btn-primary" data-analytics-event="consultation_click" data-analytics-location="home_hero">Show me what to fix</a>
          <a href="/services" class="btn btn-secondary" data-analytics-event="service_comparison_click" data-analytics-location="home_hero">See services and prices</a>
        </div>
        <ul class="hero-trust" aria-label="Service assurances">
          <li>Plain-language scope</li>
          <li>Human approval where it matters</li>
          <li>Price in writing before work begins</li>
        </ul>
      </div>

      <div class="clarity-card" aria-label="Example of a business process before and after OriginsLynk">
        <p class="card-kicker">A common before and after</p>
        <div class="clarity-row before-row">
          <span>Before</span>
          <p>Search the inbox → copy details → update a sheet → remember the follow-up → rebuild the report</p>
        </div>
        <div class="clarity-arrow" aria-hidden="true">↓</div>
        <div class="clarity-row after-row">
          <span>After</span>
          <p>One clear intake → prepared work → your approval → consistent record → visible next step</p>
        </div>
        <p class="clarity-note">The system handles repetition. You keep judgment and control.</p>
      </div>
    </div>
  </section>

  <section class="signal-strip" aria-label="Who OriginsLynk helps">
    <div class="container signal-inner">
      <p><strong>Built for busy owners and professionals</strong></p>
      <p>Serving Upstate South Carolina and selected communities in the Carolinas and Georgia.</p>
    </div>
  </section>

  <section class="proof-section">
    <div class="container proof-grid">
      <div class="proof-context">
        <p class="eyebrow">A client-reported 30-day result</p>
        <p class="proof-stat">At least <strong>20 hours a week</strong> saved by the end of week two.</p>
        <a href="/results">Read the full client result →</a>
      </div>
      <figure class="featured-quote">
        <blockquote>
          “I genuinely feel like I have accomplished a year’s worth of work in a single month.”
        </blockquote>
        <figcaption>
          Director of Marketing, The Downing Group
          <span>Customized Tier 1 implementation with operator training</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="pain-section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The cost is already showing up</p>
        <h2>If the work depends on copying, checking, and remembering, it is costing you twice.</h2>
        <p class="muted">Once in the hours you spend doing it—and again when something gets delayed, missed, or done differently.</p>
      </div>
      <div class="pain-grid">
        {painPoints.map(([title, body]) => (
          <article>
            <span aria-hidden="true"></span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="health-section section-cream">
    <div class="container health-grid">
      <div>
        <p class="eyebrow">Already have automation?</p>
        <h2>Find out what works, what is risky, and what to fix first.</h2>
        <p class="lede">The Automation Health Check gives you a plain-language answer before you spend money repairing the wrong thing.</p>
        <ul class="checklist">
          <li>Up to three existing workflows on one automation platform</li>
          <li>Safe testing, failure review, access review, and cost review</li>
          <li>A prioritized keep, repair, rebuild, monitor, or retire plan</li>
          <li>Six operator hours, with technical review stopping at cumulative hour five</li>
          <li>Repairs priced separately—no open-ended repair meter</li>
        </ul>
      </div>
      <aside class="health-price">
        <p>Automation Health Check</p>
        <strong>Starting at $350</strong>
        <span>Final diagnostic price confirmed after a free 15-minute fit call.</span>
        <a href="/contact?service=automation-health-check" class="btn btn-primary">Request a health check</a>
      </aside>
    </div>
  </section>

  <section class="services-section section-sunken">
    <div class="container">
      <div class="section-head section-head-center">
        <p class="eyebrow">Need a new system?</p>
        <h2>Start with two workflows. Add depth only when the work earns it.</h2>
        <p class="muted">Each tier includes the work before it, so you can begin small and upgrade without paying twice for compatible completed work.</p>
      </div>
      <div class="service-ladder">
        <ServiceCard service={tier1Setup} label="Tier 1 · Two workflows" featured />
        <ServiceCard service={tier2Setup} label="Tier 2 · Four total workflows" />
        <ServiceCard service={tier3Setup} label="Tier 3 · Six total workflows" />
      </div>
      <p class="upgrade-note">Compatible completed setup is credited when you move up a tier. New scope or remediation is quoted separately.</p>
    </div>
  </section>

  <section id="process" class="process-section">
    <div class="container process-grid">
      <div class="section-head">
        <p class="eyebrow">A direct path to clarity</p>
        <h2>You do not need to know the technical answer before we talk.</h2>
        <p class="muted">Bring the business problem. We will get to the core of what should change and tell you honestly when a build is not the right move.</p>
      </div>
      <ol class="process-list">
        {outcomes.map(([number, title, body]) => (
          <li><span>{number}</span><div><h3>{title}</h3><p>{body}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="trust-section section-dark">
    <div class="container trust-grid">
      <div>
        <p class="eyebrow">Built for real business consequences</p>
        <h2>Useful enough to save effort. Controlled enough to trust.</h2>
      </div>
      <div class="trust-points">
        <p><strong>You see the boundary.</strong> Every workflow states what starts it, what it prepares, and where a person reviews it.</p>
        <p><strong>Access stays narrow.</strong> We request only the permissions needed for the agreed work.</p>
        <p><strong>Delivery is testable.</strong> Scope, acceptance, support, and ownership are documented before launch.</p>
        <a href="/trust">See how we protect your work →</a>
      </div>
    </div>
  </section>

  <section class="founder-section">
    <div class="container founder-grid">
      <div class="founder-mark" aria-hidden="true">BW</div>
      <div>
        <p class="eyebrow">Direct founder involvement</p>
        <h2>You work with the person who studies, builds, and explains the system.</h2>
        <p class="lede">Bryce Worthy built OriginsLynk around a simple standard: technology should make necessary work take less of your life, and you should understand what you are buying.</p>
        <p class="muted">His background spans business operations, Microsoft 365 administration, field service, and hands-on systems engineering. Clients work directly with him from discovery through launch.</p>
      </div>
    </div>
  </section>

  <section class="final-cta section-cream">
    <div class="container final-cta-inner">
      <div>
        <p class="eyebrow">The work will repeat again next week</p>
        <h2>Make this the week you stop accepting it as normal.</h2>
      </div>
      <div>
        <p class="lede">Answer a few short questions. We will reply within one business day with the most useful next step.</p>
        <div class="btn-row"><a href="/contact" class="btn btn-primary" data-analytics-event="consultation_click" data-analytics-location="home_final">Show me what to fix</a></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; padding-block: clamp(4.5rem, 9vw, 8rem); background: radial-gradient(circle at 85% 15%, rgba(32,122,114,.12), transparent 30%), var(--ground-cream); }
  .hero-grid { display: grid; align-items: center; gap: var(--space-8); }
  .hero-copy h1 { max-width: 12ch; }
  .hero-copy h1 em { color: var(--accent-text); font-style: normal; }
  .hero-copy .lede { max-width: 54ch; margin-top: var(--space-5); }
  .hero-trust { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-5); list-style: none; padding: 0; margin-top: var(--space-6); color: var(--ink-muted); font-size: var(--text-xs); }
  .hero-trust li { position: relative; padding-left: var(--space-5); }
  .hero-trust li::before { content: "✓"; position: absolute; left: 0; color: var(--secondary-dark); font-weight: 800; }
  .clarity-card { padding: clamp(1.25rem, 4vw, var(--space-7)); border: 1px solid rgba(16,43,43,.12); border-radius: var(--radius-lg); background: rgba(255,254,250,.9); box-shadow: var(--shadow-lg); transform: rotate(1deg); }
  .card-kicker { color: var(--secondary-dark); font-size: var(--text-xs); font-weight: 760; letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  .clarity-row { margin-top: var(--space-5); padding: var(--space-5); border-radius: var(--radius); }
  .clarity-row span { display: block; margin-bottom: var(--space-2); font-size: var(--text-xs); font-weight: 760; text-transform: uppercase; letter-spacing: var(--tracking-wide); }
  .clarity-row p { font-size: var(--text-sm); font-weight: 620; }
  .before-row { background: #ece9e1; color: var(--ink-muted); }
  .after-row { background: var(--secondary-soft); color: var(--ink); border-left: 4px solid var(--secondary); }
  .clarity-arrow { width: 2.25rem; height: 2.25rem; display: grid; place-items: center; margin: var(--space-3) auto calc(var(--space-3) * -1); border-radius: 50%; background: var(--accent); color: #fff; font-weight: 800; position: relative; z-index: 1; }
  .clarity-note { margin-top: var(--space-5); color: var(--ink-muted); font-size: var(--text-xs); text-align: center; }
  .signal-strip { padding-block: var(--space-5); background: var(--ground-inverse); color: var(--ink-inverse); }
  .signal-inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2) var(--space-6); }
  .signal-inner p { font-size: var(--text-sm); }
  .signal-inner p:last-child { color: var(--ink-inverse-muted); }
  .proof-section { background: var(--ground-raised); }
  .proof-grid { display: grid; align-items: center; gap: var(--space-7); }
  .proof-context { max-width: 25rem; }
  .proof-stat { color: var(--ink-muted); font-size: var(--text-lg); line-height: var(--leading-snug); }
  .proof-stat strong { color: var(--ink); }
  .proof-context a { display: inline-block; margin-top: var(--space-5); font-size: var(--text-sm); font-weight: 720; }
  .featured-quote { padding: clamp(1.5rem, 4vw, var(--space-7)); border-left: var(--border-thick) solid var(--accent); background: var(--ground-cream); box-shadow: var(--shadow-sm); }
  .featured-quote blockquote { max-width: 28ch; color: var(--ink); font-family: var(--heading-font); font-size: clamp(1.65rem, 3vw, 2.35rem); font-weight: var(--heading-weight); line-height: var(--leading-tight); letter-spacing: var(--tracking-tight); }
  .featured-quote figcaption { margin-top: var(--space-5); color: var(--ink); font-size: var(--text-sm); font-weight: 680; }
  .featured-quote figcaption span { display: block; margin-top: var(--space-1); color: var(--ink-muted); font-weight: 500; }
  .pain-section .section-head h2 { max-width: 22ch; }
  .pain-grid { display: grid; gap: var(--space-4); }
  .pain-grid article { padding: var(--space-5); border-top: 1px solid var(--rule-strong); }
  .pain-grid article > span { display: block; width: .65rem; height: .65rem; margin-bottom: var(--space-4); border-radius: 50%; background: var(--accent); }
  .pain-grid h3 { font-size: var(--text-lg); }
  .pain-grid p { margin-top: var(--space-3); color: var(--ink-muted); font-size: var(--text-sm); }
  .health-grid { display: grid; align-items: center; gap: var(--space-8); }
  .health-grid h2 { max-width: 18ch; }
  .health-grid .lede { margin-top: var(--space-5); }
  .health-grid .checklist { margin-top: var(--space-6); }
  .health-price { padding: clamp(1.5rem, 4vw, var(--space-7)); border-radius: var(--radius-lg); background: var(--ground-inverse); color: var(--ink-inverse); box-shadow: var(--shadow-lg); }
  .health-price p { color: #9fd2cb; font-size: var(--text-xs); font-weight: 760; letter-spacing: var(--tracking-wide); text-transform: uppercase; }
  .health-price strong, .health-price span { display: block; }
  .health-price strong { margin-top: var(--space-4); font-family: var(--heading-font); font-size: var(--text-3xl); line-height: var(--leading-tight); }
  .health-price span { margin-top: var(--space-3); color: var(--ink-inverse-muted); font-size: var(--text-sm); }
  .health-price .btn { width: 100%; margin-top: var(--space-6); }
  .service-ladder { display: grid; gap: var(--space-5); }
  .upgrade-note { margin: var(--space-5) auto 0; color: var(--ink-muted); font-size: var(--text-sm); text-align: center; }
  .process-grid { display: grid; gap: var(--space-8); }
  .process-list { list-style: none; padding: 0; display: grid; gap: var(--space-4); }
  .process-list li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); padding: var(--space-5); border: 1px solid var(--rule); border-radius: var(--radius); background: var(--ground-raised); }
  .process-list > li > span { color: var(--accent-text); font-weight: 800; font-size: var(--text-xs); }
  .process-list h3 { font-size: var(--text-lg); }
  .process-list p { margin-top: var(--space-2); color: var(--ink-muted); font-size: var(--text-sm); }
  .trust-grid, .founder-grid, .final-cta-inner { display: grid; gap: var(--space-7); }
  .trust-grid h2, .final-cta h2 { max-width: 16ch; }
  .trust-points { display: grid; gap: var(--space-5); }
  .trust-points p { color: var(--ink-inverse-muted); }
  .trust-points strong { color: var(--ink-inverse); }
  .founder-grid { align-items: start; }
  .founder-mark { display: grid; place-items: center; width: 5.5rem; aspect-ratio: 1; border-radius: 50%; background: var(--secondary-soft); color: var(--secondary-dark); font-family: var(--heading-font); font-size: var(--text-xl); font-weight: 760; }
  .founder-grid .lede, .founder-grid .muted { margin-top: var(--space-5); }
  @media (min-width: 42em) {
    .pain-grid { grid-template-columns: repeat(2, 1fr); }
    .service-ladder { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 64em) {
    .hero-grid { grid-template-columns: 1.05fr .95fr; gap: var(--space-9); }
    .pain-grid { grid-template-columns: repeat(4, 1fr); }
    .health-grid { grid-template-columns: 1.2fr .8fr; }
    .proof-grid { grid-template-columns: .65fr 1.35fr; }
    .service-ladder { grid-template-columns: repeat(3, 1fr); }
    .process-grid, .trust-grid, .final-cta-inner { grid-template-columns: .9fr 1.1fr; }
    .founder-grid { grid-template-columns: auto 1fr; }
  }
</style>
